# Copy this file to .env and fill in your values.

# --- Public address & admin ---
# URL Stremio uses to reach this instance (used in the manifest/logo URLs).
ADDON_URL=http://localhost:8000
# Required to change shared ranking preferences from the settings page.
# ADMIN_API_KEY=

# --- Docker Compose ---
# Host interface/port the app is published on (see docker-compose.yml).
# CAULDRON_BIND=127.0.0.1
# CAULDRON_PORT=8000
# Set to "full" to also start the optional Zilean + Postgres services.
# COMPOSE_PROFILES=full

# --- Cache (recommended for production with multiple users) ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_MEMORY=512mb
REDIS_EVICTION_POLICY=allkeys-lru
# Set true to bypass both Redis and the in-process fallback cache.
DISABLE_CACHE=false

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS (comma-separated origins, use * for all) ---
CORS_ORIGINS=*

# --- Bitsearch (enabled by default; unauthenticated API tier is 200 requests/day) ---
BITSEARCH_ENABLED=true
# BITSEARCH_API_KEY=
# BITSEARCH_CACHE_TTL_SECONDS=3600

# --- Zilean (optional self-hosted DMM hash-list index) ---
# The bundled Compose service is private; set true after its initial index starts.
ZILEAN_ENABLED=false
ZILEAN_URL=http://zilean:8181
# Generated locally for the bundled Postgres service; never commit this value.
# ZILEAN_POSTGRES_PASSWORD=
# GitHub token Zilean uses to fetch DMM hash lists.
# GITHUB_TOKEN=

# --- Torrin (optional) ---
# TORRIN_API_KEY=

# --- Offcloud (optional file size fetching) ---
# Offcloud doesn't provide file sizes in API responses; we can fetch them via HEAD requests
# This adds latency but provides accurate file sizes for users
OFFCLOUD_FETCH_SIZES=true
# Cache file sizes for 1 hour (in seconds)
OFFCLOUD_SIZE_CACHE_TTL=3600

# --- Outbound HTTP pool (shared by all scrapers and debrid providers) ---
# HTTPX_MAX_CONNECTIONS=100
# HTTPX_MAX_KEEPALIVE_CONNECTIONS=20
