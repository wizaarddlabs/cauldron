# Copy this file to .env and fill in your values.

# --- Jackett (self-hosted indexer aggregator) ---
# Run Jackett yourself (see docker-compose.yml), add your indexers in its
# web UI, then paste its URL + API key here.
JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=
JACKETT_INDEXERS=all

# --- Cache (optional, falls back to in-memory if unset) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS (comma-separated origins, use * for all) ---
CORS_ORIGINS=*
