# Copy this file to .env and fill in your values.

# --- Cache (recommended for production with multiple users) ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_MEMORY=512mb
REDIS_EVICTION_POLICY=allkeys-lru

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS (comma-separated origins, use * for all) ---
CORS_ORIGINS=*

# --- Bitsearch (enabled by default; unauthenticated API tier is 200 requests/day) ---
BITSEARCH_ENABLED=true
# BITSEARCH_API_KEY=
# BITSEARCH_CACHE_TTL_SECONDS=3600

# --- Zilean (optional self-hosted DMM hash-list index) ---
# The bundled Compose service is private; set true after its initial index starts.
ZILEAN_ENABLED=false
ZILEAN_URL=http://zilean:8181
# Generated locally for the bundled Postgres service; never commit this value.
# ZILEAN_POSTGRES_PASSWORD=
